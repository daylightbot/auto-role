{
  "name": "Discord Mass Role Assignment",
  "nodes": [
    {
      "parameters": {},
      "id": "a1b2c3d4-0001-0001-0001-000000000001",
      "name": "▶ Run Manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [200, 500]
    },
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "minutes", "minutesInterval": 10 }]
        }
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000002",
      "name": "⏰ Schedule (every 10 min)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": { "__rl": true, "value": "YOUR_SPREADSHEET_ID", "mode": "id" },
        "sheetName":  { "__rl": true, "value": "Config", "mode": "name" },
        "options": {}
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000003",
      "name": "📋 Read Config",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [460, 400],
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "YOUR_GOOGLE_CREDENTIAL_ID", "name": "Google Sheets account" }
      }
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": { "__rl": true, "value": "YOUR_SPREADSHEET_ID", "mode": "id" },
        "sheetName":  { "__rl": true, "value": "Users", "mode": "name" },
        "filtersUI": {
          "values": [{ "lookupColumn": "status", "lookupValue": "" }]
        },
        "options": { "returnRowNumbers": true }
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000004",
      "name": "👥 Get Pending Users",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [680, 400],
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "YOUR_GOOGLE_CREDENTIAL_ID", "name": "Google Sheets account" }
      }
    },
    {
      "parameters": { "batchSize": 50, "options": {} },
      "id": "a1b2c3d4-0001-0001-0001-000000000005",
      "name": "🔁 Loop (50 users)",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [900, 400],
      "notes": "'done' output (index 0) → leave UNCONNECTED.\n'loop' output (index 1) → Add Discord Role.\nLoop runs because Sheets Delay connects back to this node's INPUT."
    },
    {
      "parameters": {
        "resource": "member",
        "operation": "roleAdd",
        "guildId": {
          "__rl": true,
          "value": "={{ $('📋 Read Config').first().json.guild_id }}",
          "mode": "id"
        },
        "userId": {
          "__rl": true,
          "value": "={{ $json.user_id }}",
          "mode": "id"
        },
        "roleId": {
          "__rl": true,
          "value": "={{ $('📋 Read Config').first().json.role_id }}",
          "mode": "id"
        }
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000006",
      "name": "🎭 Add Discord Role",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [1120, 400],
      "continueOnFail": true,
      "credentials": {
        "discordBotApi": { "id": "YOUR_DISCORD_CREDENTIAL_ID", "name": "Discord Bot account" }
      },
      "notes": "Processes all 50 items in the batch. continueOnFail captures errors without crashing."
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000007",
      "name": "🔂 One Sheets Write at a Time",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1340, 400],
      "notes": "Feeds the 50 Discord results into the Sheets update one row at a time.\n'loop' output (index 1) → Sheets Delay → Update Row Status → back to THIS node's input.\n'done' output (index 0) → back to the outer Loop node's input."
    },
    {
      "parameters": {
        "resume": "timeInterval",
        "amount": 1,
        "unit": "seconds"
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000008",
      "name": "⏳ Sheets Delay (1 sec)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1560, 260],
      "webhookId": "sheets-delay",
      "notes": "1 second between each Sheets write = max 60 writes/minute, well under quota.\nIncrease to 2s if you still see quota errors."
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": { "__rl": true, "value": "YOUR_SPREADSHEET_ID", "mode": "id" },
        "sheetName":  { "__rl": true, "value": "Users", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "row_number": "={{ $('🔁 Loop (50 users)').first().json.row_number }}",
            "status":     "={{ $json.error ? 'failed' : 'done' }}",
            "timestamp":  "={{ $now.toISO() }}",
            "error":      "={{ $json.error ? $json.error.toString().substring(0, 200) : '' }}"
          },
          "matchingColumns": ["row_number"],
          "schema": [
            { "id": "row_number", "displayName": "row_number", "required": false, "defaultMatch": true,  "display": true, "type": "string", "canBeUsedToMatch": true  },
            { "id": "status",     "displayName": "status",     "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": false },
            { "id": "timestamp",  "displayName": "timestamp",  "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": false },
            { "id": "error",      "displayName": "error",      "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": false }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000009",
      "name": "✅ Update Row Status",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [1780, 260],
      "continueOnFail": true,
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "YOUR_GOOGLE_CREDENTIAL_ID", "name": "Google Sheets account" }
      },
      "notes": "Updates one row at a time, paced by the 1-second Wait above.\ncontinueOnFail: a transient quota error leaves the row blank for retry rather than crashing."
    },
    {
      "parameters": {
        "content": "## Discord Mass Role Assignment\n\n### Flow\n```\n[Trigger]\n  → Read Config\n  → Get Pending Users\n  → Outer Loop (50 users per batch)\n      → Add Discord Role   (all 50, fast)\n      → Inner Loop (1 at a time for Sheets)\n          → Sheets Delay   (1 sec throttle)\n          → Update Row Status\n          → back to Inner Loop\n      → back to Outer Loop\n```\n\n**Why two loops?**\nDiscord can handle 50 calls in a batch quickly.\nGoogle Sheets write quota (~60/min) means we must write one row\nat a time with a 1-second gap. The inner loop paces only the\nSheets writes — Discord runs at full speed.\n\n**Loop outputs:**\n- Outer loop 'done' (index 0) → UNCONNECTED\n- Outer loop 'loop' (index 1) → Add Discord Role\n- Inner loop 'done' (index 0) → back to Outer Loop INPUT\n- Inner loop 'loop' (index 1) → Sheets Delay\n\n---\n\n### Google Sheets layout\n**Config tab — one data row:**\n| guild_id | role_id |\n|----------|---------|\n| 123...   | 987...  |\n\n**Users tab:**\n| user_id | status | timestamp | error |\n\n---\n\n### Setup checklist\n- [ ] Replace `YOUR_SPREADSHEET_ID` on Read Config,\n      Get Pending Users, Update Row Status\n- [ ] Set Google Sheets credential on those nodes\n- [ ] Set Discord Bot credential on Add Discord Role\n- [ ] Bot has MANAGE_ROLES above target role\n\n---\n\n### Throughput\n50 Discord calls per outer batch · 1 Sheets write/sec\n~60 rows/min · 10k ≈ 2.5 hrs · 600k ≈ 7 days (background)",
        "height": 720,
        "width": 520,
        "color": 5
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000010",
      "name": "📖 Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [200, -420]
    }
  ],
  "connections": {
    "▶ Run Manually": {
      "main": [[{ "node": "📋 Read Config", "type": "main", "index": 0 }]]
    },
    "⏰ Schedule (every 10 min)": {
      "main": [[{ "node": "📋 Read Config", "type": "main", "index": 0 }]]
    },
    "📋 Read Config": {
      "main": [[{ "node": "👥 Get Pending Users", "type": "main", "index": 0 }]]
    },
    "👥 Get Pending Users": {
      "main": [[{ "node": "🔁 Loop (50 users)", "type": "main", "index": 0 }]]
    },
    "🔁 Loop (50 users)": {
      "main": [
        [],
        [{ "node": "🎭 Add Discord Role", "type": "main", "index": 0 }]
      ]
    },
    "🎭 Add Discord Role": {
      "main": [[{ "node": "🔂 One Sheets Write at a Time", "type": "main", "index": 0 }]]
    },
    "🔂 One Sheets Write at a Time": {
      "main": [
        [{ "node": "🔁 Loop (50 users)", "type": "main", "index": 0 }],
        [{ "node": "⏳ Sheets Delay (1 sec)", "type": "main", "index": 0 }]
      ]
    },
    "⏳ Sheets Delay (1 sec)": {
      "main": [[{ "node": "✅ Update Row Status", "type": "main", "index": 0 }]]
    },
    "✅ Update Row Status": {
      "main": [[{ "node": "🔂 One Sheets Write at a Time", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "meta": { "templateCredsSetupCompleted": false }
}

{
  "name": "Discord Mass Role Assignment",
  "nodes": [
    {
      "parameters": {},
      "id": "a1b2c3d4-0001-0001-0001-000000000001",
      "name": "▶ Run Manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [200, 500]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000002",
      "name": "⏰ Schedule (every 10 min)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "YOUR_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Config",
          "mode": "name"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000003",
      "name": "📋 Read Config Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [460, 400],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GOOGLE_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      },
      "notes": "Reads the Config sheet. Two rows: guild_id and role_id. The bot token lives in n8n Credentials — not here."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "assign-guild-id",
              "name": "guildId",
              "value": "={{ $('📋 Read Config Sheet').all().find(i => i.json.setting === 'guild_id')?.json.value ?? '' }}",
              "type": "string"
            },
            {
              "id": "assign-role-id",
              "name": "roleId",
              "value": "={{ $('📋 Read Config Sheet').all().find(i => i.json.setting === 'role_id')?.json.value ?? '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000004",
      "name": "⚙️ Extract Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [680, 400],
      "notes": "Collapses the Config sheet rows into a single item with guildId and roleId fields."
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "YOUR_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Users",
          "mode": "name"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "status",
              "lookupValue": ""
            }
          ]
        },
        "options": {
          "returnRowNumbers": true
        }
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000005",
      "name": "👥 Get Pending Users",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [900, 400],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GOOGLE_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      },
      "notes": "Reads rows where status is blank. returnRowNumbers adds a row_number field to each item so we know exactly which row to update after the Discord call. Zero results → workflow ends naturally."
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000006",
      "name": "🔁 Loop (1 user at a time)",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1120, 400],
      "notes": "Output 0 → current user (goes to HTTP Request AND the Merge pass-through simultaneously). Output 1 → all users done, workflow ends."
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=https://discord.com/api/v10/guilds/{{ $('⚙️ Extract Config').first().json.guildId }}/members/{{ $json.user_id }}/roles/{{ $('⚙️ Extract Config').first().json.roleId }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "discordBotApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Audit-Log-Reason",
              "value": "Mass role assignment"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "responseFormat": "text",
              "neverError": true
            }
          }
        }
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000007",
      "name": "🌐 Call Discord API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 260],
      "continueOnFail": true,
      "credentials": {
        "discordBotApi": {
          "id": "YOUR_DISCORD_CREDENTIAL_ID",
          "name": "Discord Bot account"
        }
      },
      "notes": "PUT /guilds/{guildId}/members/{userId}/roles/{roleId}. Uses your n8n Discord Bot credential — no token in the sheet. neverError:true means all HTTP status codes (204, 404, 429, 403…) come back as normal output with a statusCode field rather than throwing. continueOnFail handles any network-level failures."
    },
    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "mergeByPosition",
        "options": {}
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000008",
      "name": "🔗 Merge Response + User Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [1560, 400],
      "notes": "Input 0: HTTP response (statusCode, body). Input 1: original user item (user_id, row_number). Merges both by position into one item so the next node has everything it needs."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "assign-status",
              "name": "status",
              "value": "={{ $json.statusCode === 204 || $json.statusCode === 200 ? 'done' : ($json.statusCode === 404 ? 'not_in_server' : ($json.statusCode === 429 ? 'rate_limited' : 'failed')) }}",
              "type": "string"
            },
            {
              "id": "assign-timestamp",
              "name": "timestamp",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            },
            {
              "id": "assign-error",
              "name": "error",
              "value": "={{ ($json.statusCode === 204 || $json.statusCode === 200) ? '' : ('HTTP ' + String($json.statusCode ?? 'ERR') + ': ' + String($json.body ?? $json.error ?? '').substring(0, 200)) }}",
              "type": "string"
            }
          ]
        },
        "options": {
          "includeBinary": false
        }
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000009",
      "name": "📝 Set Status Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1780, 400],
      "notes": "Translates statusCode into a human-readable status (done / not_in_server / rate_limited / failed) and builds the error message. Adds a timestamp. user_id and row_number pass through untouched."
    },
    {
      "parameters": {
        "resume": "timeInterval",
        "amount": 250,
        "unit": "milliseconds"
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000010",
      "name": "⏱ Rate Limit Delay (250 ms)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [2000, 400],
      "webhookId": "rate-limit-delay-webhook",
      "notes": "Keeps throughput at ~4 requests/second, safely under Discord's rate limits. Increase to 500ms if you see rate_limited entries appearing in the sheet."
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "YOUR_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Users",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "row_number": "={{ $json.row_number }}",
            "status":     "={{ $json.status }}",
            "timestamp":  "={{ $json.timestamp }}",
            "error":      "={{ $json.error }}"
          },
          "matchingColumns": ["row_number"],
          "schema": [
            {
              "id":             "row_number",
              "displayName":    "row_number",
              "required":       false,
              "defaultMatch":   true,
              "display":        true,
              "type":           "string",
              "canBeUsedToMatch": true
            },
            {
              "id":             "status",
              "displayName":    "status",
              "required":       false,
              "defaultMatch":   false,
              "display":        true,
              "type":           "string",
              "canBeUsedToMatch": false
            },
            {
              "id":             "timestamp",
              "displayName":    "timestamp",
              "required":       false,
              "defaultMatch":   false,
              "display":        true,
              "type":           "string",
              "canBeUsedToMatch": false
            },
            {
              "id":             "error",
              "displayName":    "error",
              "required":       false,
              "defaultMatch":   false,
              "display":        true,
              "type":           "string",
              "canBeUsedToMatch": false
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000011",
      "name": "✅ Update Row Status",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [2220, 400],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GOOGLE_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      },
      "notes": "Updates the exact sheet row by row_number. Writes status, timestamp, and error. On the next run, only rows still showing blank status are picked up."
    },
    {
      "parameters": {
        "content": "## 🚀 Discord Mass Role Assignment\n\n### Flow\n```\n[Trigger] → Read Config → Extract Config → Get Pending Users\n  → Loop ──► Call Discord API ──► Merge ──► Set Status ──► Wait ──► Update Row ──► Loop\n         └──────────────────────► Merge (pass-through user data)\n```\n\n### Google Sheets layout\n\n**Tab: Config**\n| setting  | value                |\n|----------|----------------------|\n| guild_id | 123456789012345678   |\n| role_id  | 987654321098765432   |\n\n> ✅ No bot token in the sheet. Token lives in n8n Credentials.\n\n**Tab: Users**\n| user_id            | status | timestamp | error |\n|--------------------|--------|-----------|-------|\n| 111222333444555666 |        |           |       |\n| 222333444555666777 |        |           |       |\n\nLeave **status blank** for pending users. The workflow fills it in after each call.\n\n### Before first run\n1. Replace `YOUR_SPREADSHEET_ID` on all three Google Sheets nodes\n2. Connect your **Google Sheets OAuth2** credential on those nodes\n3. Connect your **Discord Bot** credential on the HTTP Request node\n4. Ensure the bot has `MANAGE_ROLES` and sits **above** the target role in the hierarchy\n\n### Status values\n| Status         | Meaning                                     |\n|----------------|---------------------------------------------|\n| `done`         | ✅ Role assigned                            |\n| `not_in_server`| User left the server (404) — skipped next run |\n| `rate_limited` | Discord throttled the call — retried next run |\n| `failed`       | Other error — see error column              |\n\n### Throughput\n~4/sec → 10k users ≈ 42 min · 600k users ≈ 42 hrs across scheduled runs",
        "height": 700,
        "width": 520,
        "color": 5
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000012",
      "name": "📖 Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [200, -380]
    }
  ],
  "connections": {
    "▶ Run Manually": {
      "main": [
        [{"node": "📋 Read Config Sheet", "type": "main", "index": 0}]
      ]
    },
    "⏰ Schedule (every 10 min)": {
      "main": [
        [{"node": "📋 Read Config Sheet", "type": "main", "index": 0}]
      ]
    },
    "📋 Read Config Sheet": {
      "main": [
        [{"node": "⚙️ Extract Config", "type": "main", "index": 0}]
      ]
    },
    "⚙️ Extract Config": {
      "main": [
        [{"node": "👥 Get Pending Users", "type": "main", "index": 0}]
      ]
    },
    "👥 Get Pending Users": {
      "main": [
        [{"node": "🔁 Loop (1 user at a time)", "type": "main", "index": 0}]
      ]
    },
    "🔁 Loop (1 user at a time)": {
      "main": [
        [
          {"node": "🌐 Call Discord API",          "type": "main", "index": 0},
          {"node": "🔗 Merge Response + User Data", "type": "main", "index": 1}
        ],
        []
      ]
    },
    "🌐 Call Discord API": {
      "main": [
        [{"node": "🔗 Merge Response + User Data", "type": "main", "index": 0}]
      ]
    },
    "🔗 Merge Response + User Data": {
      "main": [
        [{"node": "📝 Set Status Fields", "type": "main", "index": 0}]
      ]
    },
    "📝 Set Status Fields": {
      "main": [
        [{"node": "⏱ Rate Limit Delay (250 ms)", "type": "main", "index": 0}]
      ]
    },
    "⏱ Rate Limit Delay (250 ms)": {
      "main": [
        [{"node": "✅ Update Row Status", "type": "main", "index": 0}]
      ]
    },
    "✅ Update Row Status": {
      "main": [
        [{"node": "🔁 Loop (1 user at a time)", "type": "main", "index": 0}]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
